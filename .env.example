# deepseek-vlm 服务配置模板：复制为 .env 并填入真实值（.env 已被 gitignore）
DEEPSEEK_VLM_API_KEY=change-me
DASHSCOPE_API_KEY=change-me
DEEPSEEK_API_KEY=change-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 上游 deepseek 模型名（deepseek 官方只认 deepseek-v4-flash / deepseek-v4-pro）
DEEPSEEK_MODEL=deepseek-v4-flash
# 可选：上游 pro 模型（deepseek-v4-pro-vl 路由到它；不配则用默认值）
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# 对外声称的模型名（客户端看到的 model id / 响应回显）
PUBLIC_MODEL_NAME=deepseek-v4-flash-vl
# 可选：对外 pro 模型名（/v1/models 会同时暴露两个；不配则用默认值）
PUBLIC_PRO_MODEL_NAME=deepseek-v4-pro-vl
PORT=8000
